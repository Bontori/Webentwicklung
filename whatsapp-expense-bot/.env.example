# --- General ---------------------------------------------------------------
PORT=3000
# Public HTTPS URL where this server is reachable (used for report links and
# Twilio signature checks), e.g. https://expenses.example.com or an ngrok URL.
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=./data
TIMEZONE=Asia/Jakarta
DEFAULT_CURRENCY=IDR
LOCALE=en-US
# Only these WhatsApp numbers (digits only, with country code) may log
# expenses. Leave empty to allow anyone who can message the bot (not advised).
ALLOWED_NUMBERS=6281234567890
REPORT_LINK_TTL_HOURS=72
COMPANY_NAME=

# --- Option A: Meta WhatsApp Cloud API (webhook: /webhook/meta) -------------
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=choose-a-random-string
META_GRAPH_VERSION=v23.0

# --- Option B: Twilio WhatsApp (webhook: /webhook/twilio) -------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
